# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Authentication
JWT_SECRET=documind_ultra_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite default for zero-config local dev)
DATABASE_URL=sqlite:///./documind.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documind

# Storage Configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/documents
# S3_BUCKET_NAME=documind-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI & LLM Inference (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OCR Engine
OCR_ENGINE=hybrid  # options: hybrid, paddleocr, pymupdf, mock
OCR_CONFIDENCE_THRESHOLD=0.70
AUTO_APPROVE_THRESHOLD=0.90
MANUAL_REVIEW_THRESHOLD=0.70
